# Source this file from ~/.zshrc 

zsh_dotfiles_dir=${${(%):-%N}:A:h}

# Oh My Zsh is installed outside this repo. Default path here:
ZSH=${ZSH:-$HOME/.oh-my-zsh}

# Don't use ZSH theme loader, load theme below from repo:w
ZSH_THEME=""

plugins=(git)

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
else
  print -u2 "zsh: Oh My Zsh was not found at $ZSH"
fi

source "$zsh_dotfiles_dir/git.zsh"
source "$zsh_dotfiles_dir/tmux.zsh"
source "$zsh_dotfiles_dir/af-magic.zsh-theme"

# Shell behavior and portable environment preferences.
unsetopt share_history
export EDITOR=nvim

alias wttr="curl 'wttr.in/SF?m'"

alert() {
  "$@"
  tput bel
}

# Fuzzy history picker and runner.
fh() {
  local cmd
  cmd=$(fc -l -n 1 | fzf) &&
    print -r -- "$cmd" &&
    print &&
    eval -- "$cmd"
}

killport() {
  local pids
  pids=$(lsof -ti ":$1") || return 0
  kill -9 ${(f)pids}
}

unset zsh_dotfiles_dir
